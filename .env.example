# Copier ce fichier en .env (make up le fait automatiquement)
# Dev local uniquement : ne jamais committer de vrais secrets.

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000

# --- PostgreSQL (metastore Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Clé Fernet de dev (générer la sienne : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# --- Elasticsearch / Kibana ---
ES_HOST=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- Pipeline ---
# Nombre d'articles ArXiv gardés pour le dev (0 = tout le corpus)
ARXIV_SAMPLE_SIZE=50000
# Fichier du dump ArXiv dans ./data
ARXIV_DUMP_FILE=arxiv-metadata-oai-snapshot.json
# Spark : local[2] par défaut (portable). spark://spark-master:7077 pour utiliser le cluster.
SPARK_MASTER=local[2]
# Adresse mail de courtoisie pour le "polite pool" OpenAlex (améliore les quotas)
OPENALEX_MAILTO=prenom.nom@example.com
